# Copia a `.env` solo si quieres claves del servidor (modo "el dueño paga").
# Lo normal es que cada usuario pegue la suya en Ajustes → Claves: se guarda en
# su navegador y viaja a la petición, nunca se escribe en disco en el servidor.
#
# Bun lee este archivo automáticamente en `bun run dev`.
# En Cloudflare: `wrangler secret put OPENAI_API_KEY` (nunca en el código).

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# Puerto del backend local (por defecto 8787).
# PORT=8787
