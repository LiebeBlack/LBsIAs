{
  "name": "nexo",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "description": "Nexo by LBs IAs: un chat privado y bilingüe para todos los modelos de IA.",
  "scripts": {
    "dev": "bun scripts/dev.mjs",
    "dev:client": "vite",
    "dev:api": "bun src/dev.ts",
    "build": "vite build && bun build src/worker.ts --outfile dist/server/index.js --format esm --target browser --minify",
    "deploy": "bun run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "icons": "bun scripts/gen-icons.mjs"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.1"
  },
  "engines": {
    "node": ">=20"
  }
}
